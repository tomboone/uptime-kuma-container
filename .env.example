# Copy to .env next to docker-compose.yml and fill in. .env is not committed.

KUMA_DATA_DIR=/mnt/music/uptime-kuma-personal
TS_STATE_HOST_DIR=/mnt/music/uptime-kuma-personal-tailscale

# One-time auth key from the personal tailnet (Settings → Keys). Blank it after the first start.
TS_AUTHKEY=
TS_EXTRA_ARGS=

TZ=America/New_York
